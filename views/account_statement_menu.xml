<odoo>
  <!-- Server Action -->
  <record id="action_generate_all_due_statements" model="ir.actions.server">
    <field name="name">Generate All Due Statements</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="state">code</field>
    <field name="code">action = env["account.statement.wizard"].action_generate_all_due_statements()</field>
  </record>

  <!-- Menu Item under Accounting Reports -->
  <menuitem id="menu_due_statement_report"
            name="Statement of Account"
            parent="account.menu_finance_reports"
            action="action_generate_all_due_statements"
            sequence="120"
            />

  <!-- Purchase Journal View -->
  <record id="view_purchase_journal_wizard_form" model="ir.ui.view">
    <field name="name">purchase.journal.wizard.form</field>
    <field name="model">purchase.journal.wizard</field>
    <field name="arch" type="xml">
      <form string="Purchase Journal">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group>
            <field name="vendor_id"/>
            <field name="journal_id"/>
          </group>
        </group>
        <footer>
          <button name="action_generate"
                  string="Generate"
                  type="object"
                  class="btn-primary"/>
          <button string="Cancel"
                  special="cancel"
                  class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Purchase Journal Action -->
  <record id="action_purchase_journal_wizard" model="ir.actions.act_window">
    <field name="name">Purchase Journal</field>
    <field name="res_model">purchase.journal.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Purchase Journal Menu Item -->
  <menuitem id="menu_purchase_journal"
            name="Purchase Journal"
            parent="account.menu_finance_reports"
            action="action_purchase_journal_wizard"
            sequence="121"/>

  <!-- Purchase Subsidiary Journal Action -->
  <record id="action_purchase_subsidiary_journal_wizard" model="ir.actions.act_window">
    <field name="name">Purchase Subsidiary Journal</field>
    <field name="res_model">purchase.subsidiary.journal.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Purchase Subsidiary Journal Menu Item -->
  <menuitem id="menu_purchase_subsidiary_journal"
            name="Purchase Subsidiary Journal"
            parent="account.menu_finance_reports"
            action="action_purchase_subsidiary_journal_wizard"
            sequence="122"/>

</odoo>
