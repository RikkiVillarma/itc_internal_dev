<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- SEQUENCE                                          -->
    <!-- ================================================= -->

    <record id="seq_bir_2550m" model="ir.sequence">
        <field name="name">BIR 2550M Monthly VAT Declaration</field>
        <field name="code">bir.2550m</field>
        <field name="prefix">2550M/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>


    <!-- ================================================= -->
    <!-- LIST VIEW                                         -->
    <!-- ================================================= -->

    <record id="view_bir_2550m_tree" model="ir.ui.view">
        <field name="name">bir.2550m.list</field>
        <field name="model">bir.2550m</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state == 'draft'"
                decoration-warning="state == 'generated'"
                decoration-success="state in ('confirmed', 'filed')"
                decoration-muted="state == 'cancelled'"
                multi_edit="1">

                <field name="name"         string="Reference No."/>
                <field name="display_name" string="Description"/>
                <field name="company_id"   groups="base.group_multi_company"/>
                <field name="year" readonly="state not in ('draft',)" options="{'enable_formatting': False}"/>
                <field name="month"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="item_19"  string="VAT Payable"        sum="Total" widget="monetary"/>
                <field name="item_21"  string="Tax Payable"        sum="Total" widget="monetary"/>
                <field name="item_23"  string="Total Amount Due"   sum="Grand Total" widget="monetary"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'generated'"
                       decoration-primary="state == 'confirmed'"
                       decoration-success="state == 'filed'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- FORM VIEW                                         -->
    <!-- ================================================= -->

    <record id="view_bir_2550m_form" model="ir.ui.view">
        <field name="name">bir.2550m.form</field>
        <field name="model">bir.2550m</field>
        <field name="arch" type="xml">
            <form string="BIR 2550M - Monthly VAT Declaration">

                <header>
                    <button name="action_generate_data"
                            string="Generate Data"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Auto-populate Schedule 1 and 2 from posted journal entries. Continue?"/>
                    <button name="action_generate_data"
                            string="Re-Generate Data"
                            type="object" class="btn-secondary"
                            invisible="state != 'generated'"
                            confirm="This will overwrite Schedule 1 and 2 lines. Continue?"/>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'generated'"/>
                    <button name="action_file"
                            string="Mark as Filed"
                            type="object" class="btn-success"
                            invisible="state != 'confirmed'"
                            confirm="Mark this return as Filed with the BIR? This cannot be undone."/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object" class="btn-danger"
                            invisible="state not in ('draft', 'generated')"
                            confirm="Cancel this BIR 2550M return?"/>
                    <button name="action_sync_from_schedules"
                            string="Sync from Schedules"
                            type="object" class="btn-secondary"
                            invisible="state not in ('draft', 'generated')"
                            help="Update Part II summary fields from schedule line totals."/>
                    <button name="action_create_monthly_returns"
                            string="Create All 12 Months"
                            type="object" class="btn-secondary"
                            invisible="state != 'draft'"
                            confirm="Create draft returns for all 12 months of this year? Existing months will be skipped."/>
                    <button name="action_generate_report_chatter"
                            string="Print 2550m"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,confirmed,filed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_generate_pdf"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Print</span>
                                <span class="o_stat_text">Report</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="display_name" readonly="1"/></h2>
                        <h4 class="text-muted">Monthly Value-Added Tax Declaration</h4>
                    </div>

                    <div class="alert alert-success mb-3" invisible="state != 'filed'">
                        <i class="fa fa-check-circle me-2"/>
                        Filed with BIR on
                        <field name="date_filed" readonly="1" nolabel="1" class="fw-bold d-inline"/>
                        by <field name="filed_by" readonly="1" nolabel="1" class="fw-bold d-inline"/>.
                    </div>
                    <div class="alert alert-warning mb-3" invisible="state != 'cancelled'">
                        <i class="fa fa-ban me-2"/>
                        This return has been cancelled and is no longer active.
                    </div>

                    <!-- Part I: Background Info -->
                    <separator string="Part I — Background Information"/>
                    <group>
                        <group string="Return Information">
                            <field name="company_id" readonly="state not in ('draft',)"
                                   options="{'no_create': True}"/>
                            <field name="year"  readonly="state not in ('draft',)" options="{'enable_formatting': False}"/>
                            <field name="month" readonly="state not in ('draft',)"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to"   readonly="1"/>
                            <field name="is_amended"/>
                            <field name="number_of_sheets"/>
                            <field name="hide_auto_fields"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Filing Audit">
                            <field name="date_confirmed" readonly="1" invisible="not date_confirmed"/>
                            <field name="confirmed_by"   readonly="1" invisible="not confirmed_by"/>
                            <field name="date_filed"     readonly="1" invisible="not date_filed"/>
                            <field name="filed_by"       readonly="1" invisible="not filed_by"/>
                        </group>
                    </group>
                    <group>
                        <group string="Taxpayer Information">
                            <field name="tin"             readonly="1"/>
                            <field name="rdo_code"        readonly="state in ('confirmed','filed','cancelled')"/>
                            <field name="registered_name" readonly="1"/>
                            <field name="telephone_number" readonly="1"/>
                            <field name="zip_code"        readonly="1"/>
                            <field name="line_of_business" readonly="state in ('confirmed','filed','cancelled')"/>
                        </group>
                        <group string="Tax Relief">
                            <field name="has_tax_relief"/>
                            <field name="tax_relief_specify" invisible="not has_tax_relief"
                                   readonly="state in ('confirmed','filed','cancelled')"/>
                        </group>
                    </group>

                    <!-- Part II Notebook -->
                    <notebook>

                        <!-- ===== SCHEDULE 1 ===== -->
                        <page string="Sch.1 — Vatable Sales" name="sch1">
                            <p class="text-muted">
                                Schedule of Sales/Receipts and Output Tax.
                                Lines here feed into <strong>Items 12A, 12B, 12C</strong>
                                (and each subsequent row = Items 13, 14, 15, 16).
                                Output Tax is auto-computed at 12%.
                            </p>
                            <field name="sch1_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="industry" string="Industries Covered by VAT"/>
                                    <field name="atc" string="ATC"/>
                                    <field name="sales_amount" string="Sales/Receipts Amount"
                                           sum="Total Sales"/>
                                    <field name="output_tax" string="Output Tax (12%)"
                                           readonly="1" sum="Total Output Tax"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== SCHEDULE 2 ===== -->
                        <page string="Sch.2 — Capital Goods ≤ ₱1M" name="sch2">
                            <p class="text-muted">
                                Purchases/Importation of Capital Goods with aggregate amount
                                not exceeding ₱1 Million. Input Tax is auto-computed at 12%.
                            </p>
                            <field name="sch2_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="date_purchased"/>
                                    <field name="description"/>
                                    <field name="amount" string="Amount (Net of VAT)"
                                           sum="Total"/>
                                    <field name="input_tax" string="Input Tax (12%)"
                                           readonly="1" sum="Total Input Tax"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== SCHEDULE 3 ===== -->
                        <page string="Sch.3 — Capital Goods > ₱1M" name="sch3">
                            <p class="text-muted">
                                Purchases/Importation of Capital Goods exceeding ₱1 Million.
                                Allowable input tax is amortized over the estimated/recognized life
                                (max 60 months).
                            </p>
                            <field name="sch3_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="is_previous_period" string="Prev. Period"/>
                                    <field name="date_purchased"/>
                                    <field name="description"/>
                                    <field name="amount" string="Amount (Net of VAT)" sum="Total"/>
                                    <field name="input_tax" string="Input Tax (C×12%)"
                                           readonly="1" sum="Total"/>
                                    <field name="est_life_months" string="Est. Life (mos.)"/>
                                    <field name="recognized_life" string="Recognized (mos.)"
                                           readonly="1"/>
                                    <field name="allowable_input_tax" string="Allowable (Period)"
                                           readonly="1" sum="Total Allowable"/>
                                    <field name="balance_input_tax" string="Balance (Next Period)"
                                           readonly="1" sum="Total Balance"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== SCHEDULE 4 ===== -->
                        <page string="Sch.4 — Input Tax on Govt Sales" name="sch4">
                            <p class="text-muted">
                                Input Tax Attributable to Sale to Government.
                                Feeds into <strong>Item 20B</strong>.
                            </p>
                            <field name="sch4_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="input_tax_direct"
                                           string="Input Tax Directly Attributable" sum="Total"/>
                                    <field name="taxable_sales_govt" string="Taxable Govt Sales" sum="Total"/>
                                    <field name="total_sales"         string="Total Sales"        sum="Total"/>
                                    <field name="input_tax_not_direct" string="Non-Direct Input Tax" sum="Total"/>
                                    <field name="ratable_portion"     string="Ratable Portion"
                                           readonly="1" sum="Total"/>
                                    <field name="total_input_tax"     string="Total Input Tax"
                                           readonly="1" sum="Total"/>
                                    <field name="standard_input_tax"  string="Less: Standard Input Tax" sum="Total"/>
                                    <field name="closed_to_expense"   string="Closed to Expense"
                                           readonly="1" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== SCHEDULE 5 ===== -->
                        <page string="Sch.5 — Input Tax on Exempt Sales" name="sch5">
                            <p class="text-muted">
                                Input Tax Attributable to Exempt Sales.
                                Feeds into <strong>Item 20C</strong>.
                            </p>
                            <field name="sch5_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="input_tax_direct"      string="Input Tax Directly Attributable" sum="Total"/>
                                    <field name="taxable_exempt_sale"   string="Taxable Exempt Sale"   sum="Total"/>
                                    <field name="total_sales"           string="Total Sales"            sum="Total"/>
                                    <field name="input_tax_not_direct"  string="Non-Direct Input Tax"  sum="Total"/>
                                    <field name="ratable_portion"       string="Ratable Portion"
                                           readonly="1" sum="Total"/>
                                    <field name="total_allocable"       string="Total Allocable"
                                           readonly="1" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== SCHEDULE 6 ===== -->
                        <page string="Sch.6 — Creditable VAT Withheld" name="sch6">
                            <p class="text-muted">
                                Tax Withheld Claimed as Tax Credit (BIR Form 2307).
                                Feeds into <strong>Item 20B</strong>.
                            </p>
                            <field name="sch6_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="period_covered"     string="Period Covered"/>
                                    <field name="withholding_agent"  string="Name of Withholding Agent"/>
                                    <field name="income_payment"     string="Income Payment"      sum="Total"/>
                                    <field name="total_tax_withheld" string="Total Tax Withheld"  sum="Total"/>
                                    <field name="applied_current_mo" string="Applied - Current Mo." sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== SCHEDULE 7 ===== -->
                        <page string="Sch.7 — Advance Payments" name="sch7">
                            <p class="text-muted">
                                Schedule of Advance Payments (Sugar and Flour Industries).
                                Feeds into <strong>Item 20A</strong>.
                            </p>
                            <field name="sch7_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="period_covered"     string="Period Covered"/>
                                    <field name="miller_name"        string="Name of Miller"/>
                                    <field name="taxpayer_name"      string="Name of Taxpayer"/>
                                    <field name="or_number"          string="Official Receipt No."/>
                                    <field name="amount_paid"        string="Amount Paid"          sum="Total"/>
                                    <field name="applied_current_mo" string="Applied - Current Mo." sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== SCHEDULE 8 ===== -->
                        <page string="Sch.8 — VAT Withheld on Govt Sales" name="sch8">
                            <p class="text-muted">
                                VAT Withheld on Sales to Government.
                                Feeds into <strong>Item 20C</strong>.
                            </p>
                            <field name="sch8_ids"
                                   readonly="state in ('confirmed','filed','cancelled')">
                                <list editable="bottom">
                                    <field name="period_covered"     string="Period Covered"/>
                                    <field name="withholding_agent"  string="Name of Withholding Agent"/>
                                    <field name="income_payment"     string="Income Payment"       sum="Total"/>
                                    <field name="total_tax_withheld" string="Total Tax Withheld"   sum="Total"/>
                                    <field name="applied_current_mo" string="Applied - Current Mo." sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ===== PAGE 1: PART II SUMMARY ===== -->
                        <page string="Page 1 — Part II Summary" name="summary">

                            <separator string="Item 18 — Less: Input Taxes"/>
                            <group>
                                <group>
                                    <field name="item_18a" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_18b" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_18c" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_18d" widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <group>
                                    <field name="item_18e" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_18f" widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>

                            <separator string="Item 19 — VAT Payable"/>
                            <group>
                                <field name="item_19" widget="monetary" readonly="1"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>

                            <separator string="Item 20 — Less: Tax Credits/Payments"/>
                            <group>
                                <group>
                                    <field name="item_20a" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_20b" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_20c" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_20d" widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>

                            <separator string="Item 21 — Tax Payable/(Overpayment)"/>
                            <group>
                                <field name="item_21" widget="monetary" readonly="1"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>

                            <separator string="Item 22 — Add: Penalties"/>
                            <group>
                                <group>
                                    <field name="item_22a" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_22b" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                    <field name="item_22c" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="state in ('confirmed','filed','cancelled')"/>
                                </group>
                                <group>
                                    <field name="item_22d" widget="monetary" readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>

                            <separator string="Item 23 — Total Amount Payable/(Overpayment)"/>
                            <group>
                                <field name="item_23" widget="monetary" readonly="1"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>

                        </page>

                        <!-- ===== DECLARATION ===== -->
                        <page string="Declaration (Items 24–25)" name="declaration">
                            <separator string="Item 24 — President/VP/Authorized Representative/Tax Agent"/>
                            <group>
                                <group>
                                    <field name="signatory_24_name"  string="Name of Signatory"/>
                                    <field name="signatory_24_title" string="Title/Position"/>
                                    <field name="signatory_24_tin"   string="TIN of Tax Agent (if applicable)"/>
                                </group>
                            </group>

                            <separator string="Item 25 — Treasurer/Asst. Treasurer/Authorized Representative"/>
                            <group>
                                <group>
                                    <field name="signatory_25_name"  string="Name of Signatory"/>
                                    <field name="signatory_25_title" string="Title/Position"/>
                                    <field name="signatory_25_accreditation"
                                           string="Tax Agent Accreditation No./Date (if applicable)"/>
                                </group>
                            </group>
                        </page>

                        <!-- ===== PAYMENT DETAILS ===== -->
                        <page string="Part III — Payment Details" name="payment">

                            <separator string="Item 26 — Cash/Bank Debit Memo"/>
                            <group>
                                <group>
                                    <field name="item_26_amount" string="26 Amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>

                            <separator string="Item 27 — Check"/>
                            <group>
                                <group>
                                    <field name="item_27a_bank"   string="27A Drawee Bank/Agency"/>
                                    <field name="item_27b_number" string="27B Number"/>
                                    <field name="item_27c_date"   string="27C Date"/>
                                    <field name="item_27d_amount" string="27D Amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>

                            <separator string="Item 28 — Tax Debit Memo"/>
                            <group>
                                <group>
                                    <field name="item_28a_number" string="28A Number"/>
                                    <field name="item_28b_date"   string="28B Date"/>
                                    <field name="item_28c_amount" string="28C Amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>

                            <separator string="Item 29 — Others"/>
                            <group>
                                <group>
                                    <field name="item_29a_bank"   string="29A Drawee Bank/Agency"/>
                                    <field name="item_29b_number" string="29B Number"/>
                                    <field name="item_29c_date"   string="29C Date"/>
                                    <field name="item_29d_amount" string="29D Amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>

                            <separator string="Machine Validation / Revenue Official Receipt Details"/>
                            <field name="machine_validation_details"
                                   placeholder="If not filed with the bank..."/>

                            <separator string="Stamp of Receiving Office"/>
                            <field name="receiving_office_stamp"
                                   placeholder="Stamp of Receiving Office and Date of Receipt..."/>
                        </page>

                        <!-- ===== NOTES ===== -->
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Internal notes, BIR reference numbers, filing instructions..."
                                   readonly="state in ('filed','cancelled')"/>
                        </page>

                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- SEARCH VIEW                                       -->
    <!-- ================================================= -->

    <record id="view_bir_2550m_search" model="ir.ui.view">
        <field name="name">bir.2550m.search</field>
        <field name="model">bir.2550m</field>
        <field name="arch" type="xml">
            <search string="Search BIR 2550M Returns">
                <field name="name"         string="Reference No."/>
                <field name="display_name" string="Description"/>
                <field name="year"         string="Year" options="{'enable_formatting': False}"/>
                <field name="month"/>
                <field name="company_id"   groups="base.group_multi_company"/>

                <filter string="Draft"     name="filter_draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Generated" name="filter_generated"
                        domain="[('state','=','generated')]"/>
                <filter string="Confirmed" name="filter_confirmed"
                        domain="[('state','=','confirmed')]"/>
                <filter string="Filed"     name="filter_filed"
                        domain="[('state','=','filed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Current Year" name="filter_current_year"
                        domain="[('year','=',context_today().year)]"/>

                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Year"    name="group_year"
                            context="{'group_by': 'year'}"/>
                    <filter string="Month"   name="group_month"
                            context="{'group_by': 'month'}"/>
                    <filter string="Status"  name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- ================================================= -->
    <!-- WINDOW ACTION                                     -->
    <!-- ================================================= -->

    <record id="action_bir_2550m" model="ir.actions.act_window">
        <field name="name">BIR 2550M Returns</field>
        <field name="res_model">bir.2550m</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bir_2550m_search"/>
        <field name="context">{'search_default_filter_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No BIR 2550M Returns Yet</p>
            <p>Create your first Monthly VAT Declaration. Use "Create All 12 Months"
               to batch-create all months for a year at once.</p>
        </field>
    </record>

</odoo>