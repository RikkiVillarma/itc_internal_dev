<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_inherit_withholding_tax" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.withholding.tax</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='price_subtotal']" position="before">
                <field name="withholding_tax_ids"
                       widget="many2many_tags"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>