<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sales Journal Wizard View -->
    <record id="view_sales_journal_wizard_form" model="ir.ui.view">

        <field name="name">sales.journal.wizard.form</field>
        <field name="model">sales.journal.wizard</field>

        <field name="arch" type="xml">

            <form string="Sales Journal">

                <group>

                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>

                    <group>
                        <field name="customer_id"/>
                        <field name="journal_id"/>
                    </group>

                </group>

                <footer>

                    <button
                        name="action_generate"
                        string="Generate"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>

</odoo>