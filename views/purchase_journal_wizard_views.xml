<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_journal_wizard_form" model="ir.ui.view">
        <field name="name">purchase.journal.wizard.form</field>
        <field name="model">purchase.journal.wizard</field>
        <field name="arch" type="xml">

            <form string="Purchase Journal">

                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>

                    <group>
                        <field name="vendor_id"/>
                        <field name="journal_id"/>
                    </group>
                </group>

                <footer>
                    <button name="action_generate"
                            string="Generate"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>

        </field>
    </record>

</odoo>