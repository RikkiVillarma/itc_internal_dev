<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_company_form_bir_permit" model="ir.ui.view">
    <field name="name">res.company.form.bir.permit</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="BIR Permit" name="bir_permit">
          <group>
            <group string="Permit">
              <field name="x_bir_permit_no"/>
              <field name="x_bir_permit_date"/>
              <field name="x_bir_atp_no"/>
              <field name="x_bir_atp_date"/>
            </group>
            <group string="Accreditation">
              <field name="x_bir_provider_name"/>
              <field name="x_bir_accreditation_no"/>
              <field name="x_bir_accreditation_validity"/>
            </group>
          </group>
          <group>
            <group string="Series Ranges">
              <field name="x_bir_series_range"/>
              <field name="x_bir_lpo_range"/>
              <field name="x_bir_ipo_range"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>