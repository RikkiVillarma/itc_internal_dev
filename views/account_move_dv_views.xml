<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_hr_expense_dv" model="ir.ui.view">
        <field name="name">account.move.form.inherit.hr.expense.dv</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_dv_expenses" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" invisible="not dv_expense_count">
                    <field name="dv_expense_count" widget="statinfo" string="Expenses"/>
                </button>
            </div>
            <xpath expr="//header" position="inside">
                <button name="action_export_dv_summary" type="object" string="Expense Summary (Excel)"
                        invisible="not dv_expense_count" groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
