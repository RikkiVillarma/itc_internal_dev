<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- ===========================
       QWeb Template: Sales Invoice
  ============================ -->
  <template id="custom_report_sales_invoice">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">

        <!-- ================= HEADER (lalabas sa bawat page) ================= -->
        <div class="header" style="font-family: Arial, sans-serif; padding-top: 70px; padding-bottom: 10px;">
          <div style="text-align:center; font-size:15px; line-height:1.3;">

            <!-- Company Name -->
            <div style="font-size:20px; font-weight:bold; margin-bottom:3px;">
              <t t-esc="doc.company_id.name"/>
            </div>

            <!-- Company Address -->
            <div style="max-width:600px; margin:0 auto; line-height:1.3;">
              <t t-esc="(doc.company_id.partner_id.street or '').upper()"/>
              <t t-if="doc.company_id.partner_id.street2">
                , <t t-esc="doc.company_id.partner_id.street2.upper()"/>
              </t>
              <t t-if="doc.company_id.partner_id.city">
                , <t t-esc="doc.company_id.partner_id.city.upper()"/>
              </t>
              <t t-if="doc.company_id.partner_id.state_id">
                , <t t-esc="doc.company_id.partner_id.state_id.name.upper()"/>
              </t>
              <t t-if="doc.company_id.partner_id.zip">
                <t t-esc="doc.company_id.partner_id.zip"/>
              </t>
            </div>

            <!-- TIN -->
            <div>
              VAT REG TIN:
              <t t-esc="doc.company_id.vat or ''"/>
            </div>

            <!-- Telephone -->
            <div>
              Telephone No.:
              <t t-esc="doc.company_id.phone or doc.company_id.partner_id.phone or ''"/>
            </div>

          </div>
        </div>

        <!-- ================= PAGE CONTENT ================= -->
        <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
          <div class="page" style="font-family: Arial, sans-serif; font-size: 15px; line-height:1.3;">
            <main>

              <!-- Document Header -->
              <div style="text-align:left; font-size:18px; font-weight:bold;">
                SALES INVOICE
              </div>

              <!-- Invoice Info -->
              <div style="width:100%; font-size:13px; margin-bottom:10px; overflow:hidden;">

                <!-- LEFT: SI NO. AND BR -->
                <div style="width:50%; float:left; padding:3px; box-sizing:border-box;">
                  <div style="margin-bottom:2px;">
                    <strong>SI NO.:</strong>
                    <t t-esc="doc.invoice_origin or ''"/>
                  </div>
                  <div>
                    <strong>BR:</strong> BR-00000-MAIN
                  </div>
                </div>

                <!-- RIGHT: DATE, TERM -->
                <div style="width:40%; float:right; box-sizing:border-box;">
                  <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:13px;">

                    <!-- SI DATE -->
                    <tr>
                      <td style="width:50%; border:1px solid black; padding:2px;">
                        <strong>SI Date:</strong>
                      </td>
                      <td style="width:50%; border:1px solid black; padding:2px; text-align:center;">
                        <t t-esc="doc.invoice_date.strftime('%m/%d/%Y') if doc.invoice_date else ''"/>
                      </td>
                    </tr>

                    <!-- TERM -->
                    <tr>
                      <td style="border:1px solid black; padding:2px;">
                        <strong>Term:</strong>
                      </td>
                      <td style="border:1px solid black; padding:2px; text-align:center;">
                        <t t-esc="doc.invoice_payment_term_id.name or 'Cash'"/>
                      </td>
                    </tr>

                  </table>
                </div>

                <div style="clear:both;"/>
              </div>

              <!-- Customer Information -->
              <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:13px; margin-bottom:15px;">

                <!-- Sold To -->
                <tr>
                  <td style="border:1px solid black; padding:5px; width:25%;">
                    <strong>Sold To:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px;" colspan="3">
                    <t t-esc="doc.partner_id.name or ''"/>
                  </td>
                </tr>

                <!-- Address - 2 row height -->
                <tr style="height:40px;">
                  <td style="border:1px solid black; padding:5px; width:25%; vertical-align:top;">
                    <strong>Address:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px; vertical-align:top;" colspan="3">
                    <t t-esc="doc.partner_id.contact_address or doc.partner_id.street or ''"/>
                  </td>
                </tr>

                <!-- TIN -->
                <tr>
                  <td style="border:1px solid black; padding:5px;">
                    <strong>TIN:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px;">
                    <t t-esc="doc.partner_id.vat or ''"/>
                  </td>
                </tr>

                <!-- Business Style / Trade Name -->
                <tr>
                  <td style="border:1px solid black; padding:5px;">
                    <strong>Business Style / Trade Name:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px;">
                    <t t-esc="doc.partner_id.name or ''"/>
                  </td>
                </tr>

                <!-- Delivery / Shipped To - 2 row height -->
                <tr style="height:40px;">
                  <td style="border:1px solid black; padding:5px; vertical-align:top;">
                    <strong>Delivery / Shipped To:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px; vertical-align:top;" colspan="3">
                    <t t-esc="doc.partner_shipping_id.contact_address or doc.partner_shipping_id.street or ''"/>
                  </td>
                </tr>

                <!-- Reference -->
                <tr style="height:40px;">
                  <td colspan="4" style="border:1px solid black; padding:5px; vertical-align:top;">
                    <strong>Reference:</strong>
                    <t t-esc="doc.ref or ''"/>
                  </td>
                </tr>

              </table>

              <!-- ============================================ -->
              <!-- Invoice Lines - FIXED HEIGHT + EMPTY ROWS -->
              <!-- ============================================ -->
              <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:13px; margin-bottom:2px;">
                <thead>
                  <tr style="background:#f0f0f0;">
                    <th style="border:1px solid black; padding:5px; text-align:center; font-weight:bold;">
                      Description
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:60px; font-weight:bold;">
                      Qty
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:60px; font-weight:bold;">
                      Unit
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:90px; font-weight:bold;">
                      Unit Price
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:110px; font-weight:bold;">
                      Total
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:90px; font-weight:bold;">
                      Discount
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:110px; font-weight:bold;">
                      Net Amount
                    </th>
                  </tr>
                </thead>

                <tbody>
                  <t t-foreach="range(max(7, len(doc.invoice_line_ids)))" t-as="row_index">
                    <tr style="border: none !important; border-top: none !important; border-bottom: none !important;">
                      <t t-if="row_index &lt; len(doc.invoice_line_ids)">
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px;">
                          <t t-esc="doc.invoice_line_ids[row_index].name or ''"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:center;">
                          <t t-esc="'{:,.2f}'.format(doc.invoice_line_ids[row_index].quantity or 0)"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:center;">
                          <t t-esc="doc.invoice_line_ids[row_index].product_uom_id.name or ''"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(doc.invoice_line_ids[row_index].price_unit or 0)"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format((doc.invoice_line_ids[row_index].price_unit or 0) * (doc.invoice_line_ids[row_index].quantity or 0))"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(doc.invoice_line_ids[row_index].discount or 0)"/>%
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(doc.invoice_line_ids[row_index].price_subtotal or 0)"/>
                        </td>
                      </t>
                      <t t-else="">
                        <td t-foreach="range(7)" t-as="col" style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px;">&#160;</td>
                      </t>
                    </tr>
                  </t>
                </tbody>

                <tfoot>
                  <tr>
                    <!-- Description -->
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      TOTAL
                    </td>

                    <!-- Qty Total -->
                    <td style="border:1px solid black; padding:5px; text-align:center; font-weight:bold;">
                      <t t-esc="'{:,.2f}'.format(sum(doc.invoice_line_ids.mapped('quantity')))"/>
                    </td>

                    <!-- Unit -->
                    <td style="border:1px solid black; padding:5px; text-align:center; font-weight:bold;">
                      -
                    </td>

                    <!-- Unit Price -->
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      -
                    </td>

                    <!-- Total -->
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      <t t-esc="'{:,.2f}'.format(sum((line.price_unit or 0) * (line.quantity or 0) for line in doc.invoice_line_ids))"/>
                    </td>

                    <!-- Discount -->
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      0.00
                    </td>

                    <!-- Net Amount -->
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      <t t-esc="'{:,.2f}'.format(sum(doc.invoice_line_ids.mapped('price_subtotal')))"/>
                    </td>
                  </tr>
                </tfoot>
              </table>

              <!-- Breakdown Label -->
              <div style="text-align:right; font-weight:bold; font-size:13px; margin:5px 0;">
                Breakdown:
              </div>

              <!-- ============================================ -->
              <!-- Breakdown Table with Terms and Conditions -->
              <!-- ============================================ -->
              <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:13px; margin-bottom:5px;">

                <!-- ROW 1 -->
                <tr>
                  <!-- Amount in Words -->
                  <td rowspan="2" style="width:65%; padding:8px; vertical-align:top; border:1px solid black; font-style:italic;">
                    <strong>Amount in words:</strong>
                    ***
                    <span t-esc="doc.currency_id.amount_to_text(doc.amount_total)"/>
                    ***
                  </td>

                  <td style="width:18%; padding:5px; text-align:right; border:1px solid black;">
                    VATable:
                  </td>

                  <td style="width:17%; padding:5px; text-align:right; border:1px solid black;">
                    <t t-esc="'{:,.2f}'.format(doc.amount_untaxed or 0)"/>
                  </td>
                </tr>

                <!-- ROW 2 -->
                <tr>
                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    Zero Rated:
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    0.00
                  </td>
                </tr>

                <!-- ROW 3 -->
                <tr>
                  <!-- TERMS HEADER -->
                  <td style="padding:1px; vertical-align:top; border:1px solid black;">
                    <p style="font-size:14px; text-align:center; font-weight:bold; margin:0;">
                      Terms and Conditions
                    </p>
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    Exempt:
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    0.00
                  </td>
                </tr>

                <!-- ROW 4 -->
                <tr>
                  <!-- TERMS VALUE - MERGED WITH ROW 5 -->
                  <td rowspan="4" style="padding:8px; vertical-align:top; border:1px solid black;">
                    <p style="font-size:11px; text-align:left; margin:0;">
                      1. Our liability for loss or damage ceases after delivery to the carrier in good order and condition.<br/>
                      2. This invoice is payable on demand, unless otherwise agreed upon.<br/>
                      3. The merchandise remains the property of the company until it is fully paid.<br/>
                      4. Interest will be charged on all overdue accounts.<br/>
                      5. In case of non-payment, the court of seller will have jurisdiction and the buyer agrees to pay attorney's fees and court costs resulting therefrom.
                    </p>
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    VAT:
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    <t t-esc="'{:,.2f}'.format(doc.amount_tax or 0)"/>
                  </td>
                </tr>

                <!-- ROW 5 -->
                <tr>
                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    Less: 2307 EWT:
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    <t t-esc="'{:,.2f}'.format(amount_2307_ewt or 0.0)"/>
                  </td>
                </tr>
                
                <!-- ROW 6 -->
                <tr>
                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    Less: 2307 VAT:
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black;">
                    <t t-esc="'{:,.2f}'.format(amount_2307_vat or 0.0)"/>
                  </td>
                </tr>

                <!-- ROW 7 -->
                <tr>
                  <td style="padding:5px; text-align:right; border:1px solid black; font-weight:bold;">
                    Amount Due:
                  </td>

                  <td style="padding:5px; text-align:right; border:1px solid black; font-weight:bold;">
                    <t t-esc="'{:,.2f}'.format(doc.amount_total or 0)"/>
                  </td>
                </tr>

              </table>

              <!-- ============================================ -->
              <!-- Signature Section -->
              <!-- ============================================ -->
              <div style="width:100%; font-size:13px; text-align:left; margin-top:20px;">

                <!-- Prepared By -->
                <div style="display:inline-block; width:31%; vertical-align:top; margin-right:2%;">
                  Prepared By:<br/>
                  <div style="width:80%; border-bottom:1px solid black; height:40px;"/>
                  <div style="font-size:13px; margin-top:3px;">
                    Signature over Printed Name
                  </div>
                  <div style="font-size:13px;">
                    Date:
                  </div>
                </div>

                <!-- Checked/Approved By -->
                <div style="display:inline-block; width:31%; vertical-align:top; margin-right:2%;">
                  Checked/Approved By:<br/>
                  <div style="width:80%; border-bottom:1px solid black; height:40px;"/>
                  <div style="font-size:13px; margin-top:3px;">
                    Signature over Printed Name
                  </div>
                  <div style="font-size:13px;">
                    Date:
                  </div>
                </div>

                <!-- Received By -->
                <div style="display:inline-block; width:31%; vertical-align:top;">
                  Received By:<br/>
                  <div style="width:80%; border-bottom:1px solid black; height:40px;"/>
                  <div style="font-size:13px; margin-top:3px;">
                    Signature over Printed Name
                  </div>
                  <div style="font-size:13px;">
                    Date:
                  </div>
                </div>

              </div>

              <div class="footer" style="font-family: Arial, sans-serif;">

                <!-- Printed By Info -->
                <div style="font-size:10px; text-align:left; line-height:1.3; margin-bottom:5px;">
                  Printed By: E-taxpoint Software Solutions Corp. (Open Edition - Tax Based Accounting System)<br/>
                  Acknowledgment Certificate No:<br/>
                  Acknowledgment Certificate Date Issued:<br/>
                  Permitted Series Range: SA-000000000001 - SA-999999999999
                </div>
              </div>

            </main>

          </div>
        </div>
      </t>
    </t>
  </template>

  <!-- ===========================
       REPORT ACTION
  ============================ -->
  <record id="report_sales_invoice_account_move" model="ir.actions.report">
    <field name="name">Sales Invoice</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">itc_internal_dev.custom_report_sales_invoice</field>
    <field name="print_report_name">'Sales Invoice - %s' % (object.invoice_origin or '')</field>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>
</odoo>