<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- ===========================
       Paper Format: Service Invoice
  ============================ -->
  <record id="paperformat_service_invoice" model="report.paperformat">
    <field name="name">Service Invoice (A4)</field>
    <field name="default" eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">50</field>
    <field name="margin_bottom">40</field>
    <field name="margin_left">7</field>
    <field name="margin_right">7</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">10</field>
    <field name="dpi">90</field>
  </record>

  <!-- ===========================
       QWeb Template: Service Invoice
       Layout follows RR No. 006-2026 Annex "B-1" (VAT Invoice)
  ============================ -->
  <template id="custom_report_service_invoice">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">

        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="cp" t-value="doc.company_id.partner_id"/>
        <t t-set="buyer" t-value="doc.partner_id"/>
        <t t-set="ship" t-value="doc.partner_shipping_id or doc.partner_id"/>
        <t t-set="currency_code" t-value="doc.currency_id.name or ''"/>
        <!-- Prefix inserted before the currency unit in the amount in words -->
        <t t-set="currency_prefix" t-value="{'SGD': 'Singaporean', 'USD': 'US'}.get(currency_code, '')"/>

        <!-- ================= HEADER (lalabas sa bawat page) ================= -->
        <!-- Annex B-1 item 4: Registered name, VAT REG TIN + branch code, registered address -->
        <div class="header" style="font-family: Arial, sans-serif; padding-bottom: 10px;">
          <div style="text-align:center; font-size:15px; line-height:1.3;">

            <!-- Registered Name -->
            <div style="font-size:20px; font-weight:bold; margin-bottom:3px;">
              <t t-esc="company.name"/>
            </div>

            <!-- VAT REG TIN (includes branch code) -->
            <div>
              VAT REG TIN:
              <t t-esc="company.vat or ''"/>
            </div>

            <!-- Registered Business Address -->
            <div style="max-width:650px; margin:0 auto; line-height:1.3;">
              <t t-esc="', '.join(x for x in [cp.street, cp.street2, cp.city, cp.state_id.name, cp.zip] if x).upper()"/>
            </div>

            <!-- Telephone (optional, shown only if set) -->
            <div t-if="company.phone or cp.phone">
              Telephone No.:
              <t t-esc="company.phone or cp.phone"/>
            </div>

          </div>
        </div>

        <!-- ================= FOOTER (lalabas sa bawat page) ================= -->
        <!-- Annex B-1 item 13: Permit to Use / ATP details -->
        <div class="footer" style="font-family: Arial, sans-serif; font-size:9px; line-height:1.4;">
          <table style="width:100%; border-collapse:collapse; border-top:1px solid black;">
            <tr>
              <td style="width:50%; vertical-align:top; padding-top:4px;">
                Printer / Software Provider:
                <t t-esc="company.x_bir_provider_name or ''"/><br/>
                ATP No. / OCN:
                <t t-esc="company.x_bir_atp_no or ''"/><br/>
                Date Issued:
                <t t-esc="company.x_bir_atp_date.strftime('%m/%d/%Y') if company.x_bir_atp_date else ''"/><br/>
                BIR Permit No. (PTU / ACCN / PTI):
                <t t-esc="company.x_bir_permit_no or ''"/>
              </td>
              <td style="width:50%; vertical-align:top; padding-top:4px;">
                Accreditation No.:
                <t t-esc="company.x_bir_accreditation_no or ''"/><br/>
                Accreditation Validity:
                <t t-esc="company.x_bir_accreditation_validity or ''"/><br/>
                Approved Series Range:
                <t t-esc="company.x_bir_series_range or ''"/>
              </td>
            </tr>
          </table>
        </div>

        <!-- ================= PAGE CONTENT ================= -->
        <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
          <div class="page" style="font-family: Arial, sans-serif; font-size: 15px; line-height:1.3;">
            <main>

              <!-- ============================================ -->
              <!-- Computations (classification uses account.tax.x_vat_category) -->
              <!-- ============================================ -->
              <t t-set="product_lines"
                t-value="doc.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>

              <t t-set="vatable_lines"
                t-value="product_lines.filtered(lambda l: 'vatable' in l.tax_ids.mapped('x_vat_category'))"/>
              <t t-set="zero_rated_lines"
                t-value="(product_lines - vatable_lines).filtered(lambda l: 'zero_rated' in l.tax_ids.mapped('x_vat_category'))"/>
              <!-- Exempt, plus any line without a VAT category (blocked at posting for new invoices) -->
              <t t-set="exempt_lines"
                t-value="product_lines - vatable_lines - zero_rated_lines"/>

              <t t-set="vatable_sales" t-value="sum(vatable_lines.mapped('price_subtotal'))"/>
              <t t-set="zero_rated_sales" t-value="sum(zero_rated_lines.mapped('price_subtotal'))"/>
              <t t-set="exempt_sales" t-value="sum(exempt_lines.mapped('price_subtotal'))"/>

              <!-- Output VAT: tax lines of VATable taxes -->
              <t t-set="vat_amount"
                t-value="sum(abs(l.amount_currency) for l in doc.line_ids if l.tax_line_id.x_vat_category == 'vatable')"/>

              <!-- Withholding taxes placed directly on the invoice lines (taxes without a VAT category) -->
              <t t-set="invoice_cwt"
                t-value="sum(abs(l.amount_currency) for l in doc.line_ids if l.tax_line_id and not l.tax_line_id.x_vat_category)"/>

              <!-- Withholding recorded on payments -->
              <t t-set="reconciled_payments"
                t-value="doc._get_reconciled_payments()"/>
              <t t-set="referenced_payments"
                t-value="env['account.payment'].search([('memo', '=', doc.name)])"/>
              <t t-set="all_invoice_payments"
                t-value="reconciled_payments | referenced_payments"/>
              <t t-set="payment_cwt"
                t-value="sum(abs(payment.wht_amount or 0.0) for payment in all_invoice_payments)"/>
              <t t-set="vat_withholding"
                t-value="sum(abs(payment.payment_tax_amount or 0.0) for payment in all_invoice_payments)"/>

              <t t-set="cwt_total" t-value="invoice_cwt + payment_cwt"/>

              <!-- Annex B-1 item 9 flow -->
              <t t-set="total_sales" t-value="vatable_sales + zero_rated_sales + exempt_sales + vat_amount"/>
              <t t-set="net_of_vat" t-value="total_sales - vat_amount"/>
              <t t-set="special_discount" t-value="0.0"/>
              <t t-set="amount_due"
                t-value="max(0.0, net_of_vat - special_discount + vat_amount - cwt_total - vat_withholding)"/>

              <!-- Amount in words, with currency name (e.g. Singaporean Dollars, US Dollars) -->
              <t t-set="unit_label" t-value="doc.currency_id.currency_unit_label or ''"/>
              <t t-set="amount_words_raw" t-value="doc.currency_id.amount_to_text(amount_due)"/>
              <t t-set="amount_words"
                t-value="amount_words_raw.replace(' ' + unit_label, ' ' + currency_prefix + ' ' + unit_label, 1) if (currency_prefix and unit_label and (currency_prefix + ' ' + unit_label) not in amount_words_raw) else amount_words_raw"/>

              <!-- Line table totals -->
              <t t-set="gross_total" t-value="sum(l.quantity * l.price_unit for l in product_lines)"/>
              <t t-set="net_total" t-value="sum(product_lines.mapped('price_subtotal'))"/>
              <t t-set="discount_total" t-value="gross_total - net_total"/>

              <!-- ============================================ -->
              <!-- Title (item 1) + Serial No. (item 5) + Date (item 6) -->
              <!-- ============================================ -->
              <table style="width:100%; border-collapse:collapse; margin-bottom:10px;">
                <tr>
                  <td style="width:55%; vertical-align:bottom; padding:0;">
                    <div style="font-size:13px; font-weight:bold; letter-spacing:2px;">SERVICE</div>
                    <div style="font-size:30px; font-weight:bold; line-height:1;">INVOICE</div>
                    <div style="font-size:13px; margin-top:6px;">
                      <strong>SI NO.:</strong>
                      <t t-esc="doc.name or ''"/>
                    </div>
                    <div style="font-size:13px;">
                      <strong>BR:</strong> BR-00000-MAIN
                    </div>
                  </td>
                  <td style="width:45%; vertical-align:bottom; padding:0;">
                    <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:13px;">
                      <tr>
                        <td style="width:50%; border:1px solid black; padding:3px;">
                          <strong>Date:</strong>
                        </td>
                        <td style="width:50%; border:1px solid black; padding:3px; text-align:center;">
                          <t t-esc="doc.invoice_date.strftime('%m/%d/%Y') if doc.invoice_date else ''"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:3px;">
                          <strong>Term:</strong>
                        </td>
                        <td style="border:1px solid black; padding:3px; text-align:center;">
                          <t t-esc="doc.invoice_payment_term_id.name or 'Cash'"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:3px;">
                          <strong>Currency:</strong>
                        </td>
                        <td style="border:1px solid black; padding:3px; text-align:center;">
                          <t t-esc="currency_code"/>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- ============================================ -->
              <!-- Buyer Information (item 7) -->
              <!-- ============================================ -->
              <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:13px; margin-bottom:12px;">
                <tr>
                  <td colspan="2" style="border:1px solid black; padding:4px 5px; background:#f0f0f0;">
                    <strong>SOLD TO:</strong>
                  </td>
                </tr>
                <tr>
                  <td style="border:1px solid black; padding:5px; width:28%;">
                    <strong>Registered Name:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px;">
                    <t t-esc="buyer.name or ''"/>
                  </td>
                </tr>
                <tr>
                  <td style="border:1px solid black; padding:5px;">
                    <strong>TIN:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px;">
                    <t t-esc="buyer.vat or ''"/>
                  </td>
                </tr>
                <tr style="height:40px;">
                  <td style="border:1px solid black; padding:5px; vertical-align:top;">
                    <strong>Business Address:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px; vertical-align:top;">
                    <t t-esc="', '.join(x for x in [buyer.street, buyer.street2, buyer.city, buyer.state_id.name, buyer.zip] if x)"/>
                  </td>
                </tr>
                <tr>
                  <td style="border:1px solid black; padding:5px;">
                    <strong>Business Style / Trade Name:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px;">
                    <t t-esc="buyer.name or ''"/>
                  </td>
                </tr>
                <tr style="height:40px;">
                  <td style="border:1px solid black; padding:5px; vertical-align:top;">
                    <strong>Delivery / Shipped To:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px; vertical-align:top;">
                    <t t-esc="', '.join(x for x in [ship.street, ship.street2, ship.city, ship.state_id.name, ship.zip] if x)"/>
                  </td>
                </tr>
                <tr>
                  <td style="border:1px solid black; padding:5px;">
                    <strong>Reference:</strong>
                  </td>
                  <td style="border:1px solid black; padding:5px;">
                    <t t-esc="doc.x_reference_number or doc.invoice_origin or ''"/>
                  </td>
                </tr>
              </table>

              <!-- ============================================ -->
              <!-- Zero-rated / VAT-exempt sale notice -->
              <!-- ============================================ -->
              <div t-if="zero_rated_lines or exempt_lines"
                   style="text-align:center; font-size:16px; font-weight:bold; border:2px solid black; padding:4px; margin-bottom:8px;">
                <t t-if="zero_rated_lines">ZERO-RATED SALE</t>
                <t t-if="zero_rated_lines and exempt_lines"> / </t>
                <t t-if="exempt_lines">VAT-EXEMPT SALE</t>
              </div>

              <!-- ============================================ -->
              <!-- Details of Transaction (item 8) - FIXED HEIGHT + EMPTY ROWS -->
              <!-- ============================================ -->
              <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:13px; margin-bottom:2px;">
                <thead>
                  <tr style="background:#f0f0f0;">
                    <th style="border:1px solid black; padding:5px; text-align:center; font-weight:bold;">
                      Item Description / Nature of Service
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:60px; font-weight:bold;">
                      Qty
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:60px; font-weight:bold;">
                      Unit
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:90px; font-weight:bold;">
                      Unit Price
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:110px; font-weight:bold;">
                      Total
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:80px; font-weight:bold;">
                      Discount
                    </th>
                    <th style="border:1px solid black; padding:5px; text-align:center; width:110px; font-weight:bold;">
                      Amount
                    </th>
                  </tr>
                </thead>

                <tbody>
                  <t t-foreach="range(max(7, len(product_lines)))" t-as="row_index">
                    <tr style="border: none !important; border-top: none !important; border-bottom: none !important;">
                      <t t-if="row_index &lt; len(product_lines)">
                        <t t-set="line" t-value="product_lines[row_index]"/>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px;">
                          <t t-esc="line.name or line.product_id.display_name or ''"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:center;">
                          <t t-esc="'{:,.2f}'.format(line.quantity)"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:center;">
                          <t t-esc="line.product_uom_id.name or ''"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(line.price_unit)"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(line.quantity * line.price_unit)"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="('{:g}'.format(line.discount) + '%') if line.discount else '0%'"/>
                        </td>
                        <td style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                        </td>
                      </t>
                      <t t-else="">
                        <td t-foreach="range(7)" t-as="col" style="border: none !important; border-left:1px solid black !important; border-right:1px solid black !important; padding:5px;"> </td>
                      </t>
                    </tr>
                  </t>
                </tbody>

                <tfoot>
                  <tr>
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      TOTAL
                    </td>
                    <td style="border:1px solid black; padding:5px; text-align:center; font-weight:bold;">
                      <t t-esc="'{:,.2f}'.format(sum(product_lines.mapped('quantity')))"/>
                    </td>
                    <td style="border:1px solid black; padding:5px; text-align:center; font-weight:bold;">
                      -
                    </td>
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      -
                    </td>
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      <t t-esc="'{:,.2f}'.format(gross_total)"/>
                    </td>
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      <t t-esc="'{:,.2f}'.format(discount_total)"/>
                    </td>
                    <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                      <t t-esc="'{:,.2f}'.format(net_total)"/>
                    </td>
                  </tr>
                </tfoot>
              </table>

              <!-- ============================================ -->
              <!-- Summary: VAT breakdown (item 10) + Totals (items 9, 11) + SC/PWD (item 12) -->
              <!-- ============================================ -->
              <table style="width:100%; border-collapse:collapse; font-size:13px; margin-top:8px;">
                <tr>
                  <!-- LEFT -->
                  <td style="width:42%; vertical-align:top; padding:0 8px 0 0;">

                    <!-- VAT Breakdown -->
                    <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">VATable Sales</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right; width:45%;">
                          <t t-esc="'{:,.2f}'.format(vatable_sales)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">VAT</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(vat_amount)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">Zero-Rated Sales</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(zero_rated_sales)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">VAT-Exempt Sales</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(exempt_sales)"/>
                        </td>
                      </tr>
                    </table>

                    <!-- Amount in Words -->
                    <div style="border:1px solid black; padding:6px; margin-top:8px; font-style:italic;">
                      <strong>Amount in words:</strong>
                      *** <t t-esc="amount_words"/> ***
                    </div>

                  </td>

                  <!-- RIGHT -->
                  <td style="width:58%; vertical-align:top; padding:0;">

                    <!-- Totals -->
                    <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <strong>Total Sales</strong> (VAT Inclusive)
                        </td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right; width:38%;">
                          <t t-esc="'{:,.2f}'.format(total_sales)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">Less: VAT</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(vat_amount)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">Amount: Net of VAT</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(net_of_vat)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          Less: Discount (SC/PWD/NAAC/MOV/SP)
                        </td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(special_discount)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">Add: VAT</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(vat_amount)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">Less: Withholding Tax</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(cwt_total)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">Less: Withholding VAT</td>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          <t t-esc="'{:,.2f}'.format(vat_withholding)"/>
                        </td>
                      </tr>
                      <tr>
                        <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                          TOTAL AMOUNT DUE (<t t-esc="currency_code"/>)
                        </td>
                        <td style="border:1px solid black; padding:5px; text-align:right; font-weight:bold;">
                          <t t-esc="'{:,.2f}'.format(amount_due)"/>
                        </td>
                      </tr>
                    </table>

                    <!-- SC / PWD / NAAC / MOV / Solo Parent -->
                    <table style="width:100%; border:1px solid black; border-collapse:collapse; margin-top:8px; font-size:12px;">
                      <tr>
                        <td style="border:1px solid black; padding:4px 5px; text-align:right; width:62%;">
                          SC/PWD/NAAC/MOV/Solo Parent ID No.:
                        </td>
                        <td style="border:1px solid black; padding:4px 5px;"> </td>
                      </tr>
                      <tr style="height:30px;">
                        <td style="border:1px solid black; padding:4px 5px; text-align:right;">
                          SC/PWD/NAAC/MOV/Solo Parent Signature:
                        </td>
                        <td style="border:1px solid black; padding:4px 5px;"> </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              <!-- ============================================ -->
              <!-- Terms and Conditions -->
              <!-- ============================================ -->
              <table style="width:100%; border:1px solid black; border-collapse:collapse; font-size:12px; margin-top:8px;">
                <tr>
                  <td style="border:1px solid black; padding:3px; text-align:center; font-weight:bold; background:#f0f0f0;">
                    Terms and Conditions
                  </td>
                </tr>
                <tr>
                  <td style="border:1px solid black; padding:6px 8px;">
                    1. Our liability ceases after rendition of services.<br/>
                    2. This Invoice is payable on demand, unless otherwise agreed upon.<br/>
                    3. Interest will be charged on all overdue accounts.<br/>
                    4. In case of non-payment, the court of service provider will have jurisdiction and the client hereby agrees to pay attorney's fees and court costs resulting from.
                  </td>
                </tr>
              </table>

            </main>
          </div>
        </div>
      </t>
    </t>
  </template>

  <!-- ===========================
       REPORT ACTION
  ============================ -->
  <record id="report_service_invoice_account_move" model="ir.actions.report">
    <field name="name">Service Invoice</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">itc_internal_dev.custom_report_service_invoice</field>
    <field name="print_report_name">'Service Invoice - %s' % (object.name)</field>
